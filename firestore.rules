rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function actorDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function actorDocExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function actorIsActive() {
      return actorDocExists() && actorDoc().data.status == "active";
    }

    function actorIsAdmin() {
      return actorIsActive() && actorDoc().data.role == "admin";
    }

    function actorIsSuperAdmin() {
      return actorIsActive() && actorDoc().data.role == "superAdmin";
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isActiveOwner(uid) {
      return isOwner(uid) && actorIsActive();
    }

    function canReadAnyProfile() {
      return actorIsAdmin() || actorIsSuperAdmin();
    }

    function allowedCreateKeys() {
      return [
        "uid",
        "email",
        "displayName",
        "photoUrl",
        "role",
        "status",
        "createdAt",
        "lastLogin"
      ];
    }

    function allowedUpdateKeys() {
      return ["email", "displayName", "photoUrl", "lastLogin"];
    }

    function isStrictStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.photoUrl == resource.data.photoUrl
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastLogin == resource.data.lastLogin
        && request.resource.data.status in ["active", "suspended", "disabled"];
    }

    function isStrictRoleUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.photoUrl == resource.data.photoUrl
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastLogin == resource.data.lastLogin
        && request.resource.data.role in ["user", "admin"];
    }

    function isValidNewUserDocument(uid) {
      return request.resource.data.keys().hasAll(allowedCreateKeys())
        && request.resource.data.keys().hasOnly(allowedCreateKeys())
        && request.resource.data.uid == uid
        && request.resource.data.uid is string
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.photoUrl is string
        && request.resource.data.role == "user"
        && request.resource.data.status == "active"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastLogin is timestamp;
    }

    function isValidSelfUpdate() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.photoUrl is string
        && request.resource.data.lastLogin is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedUpdateKeys());
    }

    function isValidStudentDataDocument() {
      return request.resource.data.keys().hasAll([
          "schemaVersion",
          "saveRevision",
          "updatedAt",
          "values"
        ])
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion > 0
        && request.resource.data.saveRevision is int
        && request.resource.data.saveRevision >= 0
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.values is map;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || canReadAnyProfile();
      allow list: if canReadAnyProfile();
      allow create: if isOwner(uid) && isValidNewUserDocument(uid);
      allow update:
        if (isOwner(uid) && isValidSelfUpdate())
        || (
          signedIn()
          && request.auth.uid != uid
          && actorIsAdmin()
          && resource.data.role == "user"
          && isStrictStatusUpdate()
        )
        || (
          signedIn()
          && request.auth.uid != uid
          && actorIsSuperAdmin()
          && (
            (resource.data.role == "user" || resource.data.role == "admin")
            && isStrictStatusUpdate()
          )
        )
        || (
          signedIn()
          && request.auth.uid != uid
          && actorIsSuperAdmin()
          && (
            (resource.data.role == "user" && request.resource.data.role == "admin")
            || (resource.data.role == "admin" && request.resource.data.role == "user")
          )
          && isStrictRoleUpdate()
        );
      allow delete: if false;

      match /data/{blockKey} {
        allow read: if isActiveOwner(uid);
        allow create: if isActiveOwner(uid) && isValidStudentDataDocument();
        allow update: if isActiveOwner(uid) && isValidStudentDataDocument();
        allow delete: if false;
      }
    }
  }
}
